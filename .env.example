# Supabase (database; no auth in this single-user tool)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: photos (images bucket) and generated clips/voiceover (videos bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET=
R2_VIDEOS_BUCKET=

# Optional: if set, Gemini writes the script and post copy instead of Claude
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude: reads the label (and writes the script when no Gemini key)
ANTHROPIC_API_KEY=
# Optional: model override (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# ElevenLabs: voiceover. Use any voice id from your account (elevenlabs.io > Voices).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional (default eleven_multilingual_v2)
ELEVENLABS_MODEL=
# Refuse to voice scripts longer than this many characters (about 1 minute is ~900)
MAX_VOICE_CHARS=1800

# Set to true to test the whole flow for free: silent voiceover.
MOCK_AI=false

# Final video render (ffmpeg-static is used automatically; these are optional)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FONTS_DIR=./assets/fonts
# RENDER_PRESET=veryfast

# Social posting (Social tab). The admin login (SESSION_SECRET + ADMIN_EMAILS, or APP_PASSWORD) is required first.
APP_PASSWORD=
# 16+ random characters; encrypts the saved Instagram / TikTok tokens
TOKEN_ENCRYPTION_KEY=
# Your deployed https URL, used for the OAuth redirect (e.g. https://your-app.vercel.app)
APP_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram API with Instagram Login (Meta developer app)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# YouTube (Google Cloud OAuth client, web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Rewards members (Supabase Auth email + password, at /join and /signin).
# Invite-only by default: make codes with POST /api/invites (admin). Set true to let anyone join.
OPEN_SIGNUP=false
# Scans a member can submit per 24 hours (each costs an AI label read). Default 1.
MEMBER_DAILY_SUBMISSIONS=1

# Admin sign-in on /login: your Supabase Auth email(s) + that account's password.
# SESSION_SECRET (32+ random characters) signs the admin cookie. Leave APP_PASSWORD empty
# once these are set (it only remains for HTTP Basic auth from scripts).
ADMIN_EMAILS=
SESSION_SECRET=

# Optional: render videos on the Cloud Run render worker (worker/README.md) instead of in a Vercel function.
# RENDER_WORKER_URL=https://fooddie-render-xxxxx.a.run.app
# RENDER_WORKER_SECRET=
